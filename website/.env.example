NEXT_PUBLIC_SUPABASE_URL=[your_supabase_url]
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=[your_supabase_publishable_key]
SUPABASE_SECRET_KEY=[your_supabase_secret_key]

# Legacy aliases still work during migration.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_P2P_SIGNAL_URL=ws://localhost:3001

# Secret for signing P2P signaling JWTs. Use a secure random string.
P2P_SIGNAL_JWT_SECRET=a-very-secure-secret-for-webrtc-signaling
P2P_SIGNAL_PORT=3001
